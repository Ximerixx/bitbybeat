?
pageindex 0 1
text 49 Derivative "[parent().par.Textoff, parent().par.Texton, parent().par.Textoff, parent().par.Texton][int(math.ceil(op('tstate')[0]))]"
type 0 multiline
legacyfontselection 0 on
scaletofit 0 onlyshrink
fontsize 34 20
fontcolorr 49 0.5 [.65,.8][parent().panel.select]
