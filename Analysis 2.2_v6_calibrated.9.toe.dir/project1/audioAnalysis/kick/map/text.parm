textpaddingt 0 3
alignx 2 center
x 2 0
w 34 400
h 34 300
layer 0 2
display 49 on "not (int(parent().par.Indicator!='text' or (parent().par.Behavior=='pulse' and parent().par.Labellocate!='none')))"
clickthrough 0 on
bgcolorr 49 0.23 [.045,.2][int(parent().par.Value1)]
bgcolorg 49 0.23 me.par.bgcolorr
bgcolorb 49 0.23 me.par.bgcolorr
bgalpha 49 1 [.3,0][parent().par.Behavior=='pulse']
top 0 ./textback
borderar 49 0.17 [.17,.6,.5,.9][int(op('tstate')[0])]
borderag 49 0.17 me.par.borderar
borderab 49 0.17 me.par.borderar
borderaalpha 49 1 [1,0][parent().par.Behavior=='pulse']
leftborder 0 bordera
leftborderi 0 bordera
rightborder 0 bordera
rightborderi 0 bordera
bottomborder 0 bordera
bottomborderi 0 bordera
topborder 0 bordera
topborderi 0 bordera
borderover 0 off
