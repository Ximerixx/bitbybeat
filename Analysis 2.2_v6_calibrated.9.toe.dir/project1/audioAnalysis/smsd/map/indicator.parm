pageindex 0 7
x 2 0
w 49 20 "parent().height * me.par.Iconaspect"
layer 0 2
vmode 0 fill
display 49 on "int(parent().par.Indicator!='text' or (parent().par.Behavior=='pulse' and parent().par.Labellocate!='none'))"
clickthrough 0 on
top 49 selectIndicator me.par.Iconswitch.eval()
borderaalpha 0 0
borderbalpha 0 0
borderover 0 off
Topoff 67108977 "('dotoff' if parent().par.Icontopon==None else parent().par.Icontopon) if parent().par.Icontopoff==None else parent().par.Icontopoff" "('./dotoff' if parent().par.Icontopon==None else parent().par.Icontopon) if parent().par.Icontopoff==None else parent().par.Icontopoff"
Topon 67108977 "'dotoffon' if parent().par.Icontopon==None else parent().par.Icontopon" "'./dotoff' if parent().par.Icontopon==None else parent().par.Icontopon"
Topoffroll 67108977 "" "(me.par.Topoff if parent().par.Icontopoff==None else parent().par.Icontopoff) if parent().par.Icontopoffroll==None else parent().par.Icontopoffroll"
Toponroll 67108977 "me.par.Topon if parent().par.Icontoponroll==None else parent().par.Icontoponroll" "me.par.Topon if parent().par.Icontoponroll==None else parent().par.Icontoponroll"
Iconswitch 67108977 "" "[me.par.Topoff.eval(), me.par.Topon.eval(), me.par.Topoffroll.eval(), me.par.Toponroll.eval()][int(op('tstate')[0])]"
Iconaspect 67108977 0 "me.par.Iconswitch.eval().width / me.par.Iconswitch.eval().height"
